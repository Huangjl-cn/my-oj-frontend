{
  "description": "Repository hooks for the MyOJ frontend.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/format-after-edit.mjs\"",
            "commandWindows": "node .codex/hooks/format-after-edit.mjs",
            "timeout": 30,
            "statusMessage": "Formatting edited frontend files"
          }
        ]
      }
    ]
  }
}
